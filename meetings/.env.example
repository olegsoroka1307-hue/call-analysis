# Скопіюйте цей файл у .env і вставте свої ключі.
# Файл .env у git не потрапляє — так і має бути.

# Ключ Anthropic: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-ваш-ключ-сюди

# Внутрішній ключ інтеграції Notion: notion.so/my-integrations
# Не забудьте поділитися базою з інтеграцією: сторінка бази → «...» →
# Connections → ваша інтеграція. Без цього Notion відповідатиме 404.
NOTION_API_KEY=secret_ваш-ключ-сюди

# Токен бота: у Telegram напишіть @BotFather команду /newbot
TELEGRAM_BOT_TOKEN=1234567:AA-ваш-токен-сюди
