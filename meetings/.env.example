# Скопіюйте у .env і заповніть. Цей файл у git не потрапляє.

# Ключ Anthropic: console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Внутрішній ключ інтеграції Notion: notion.so/my-integrations
# Починається на secret_ або ntn_. Не забудьте дати інтеграції доступ
# до бази «Домовленості»: сторінка бази → «...» → Connections.
NOTION_API_KEY=

# Токен бота від @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
