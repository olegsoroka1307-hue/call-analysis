# Скопіюйте у .env. Цей файл у git не потрапляє.

# Freelancehunt: акаунт → «Додатки та API» → створити токен
FREELANCEHUNT_TOKEN=

# Потрібен лише для чернеток відгуків (можна запускати з --no-draft)
ANTHROPIC_API_KEY=

# Потрібен, лише якщо notify_telegram: true. Бот створюється в @BotFather
TELEGRAM_BOT_TOKEN=
