# --- База даних -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/betting_poc

# --- Провайдер коефіцієнтів -------------------------------------------------
# replay        — офлайн-датасет (синтетичні дані, працює без мережі)
# the_odds_api  — реальний HTTP до api.the-odds-api.com (потрібен ключ + доступ)
ODDS_PROVIDER=replay
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_REGIONS=eu
REPLAY_DATA_DIR=data

# --- Ключі для Gate 0 harness (gate0/validate_providers.py) -----------------
THE_ODDS_API_KEY=
API_FOOTBALL_KEY=
SPORTMONKS_API_KEY=

# --- Модель -----------------------------------------------------------------
MODEL_VERSION=0.1.0-poisson
DEFAULT_BOOKMAKER=Stake
DEFAULT_TIMEZONE=Europe/Warsaw

# Тестові lambda для PoC (ТЗ §52 п.7). Реальні рахуються у Sprint 2 (ТЗ §11).
POC_LAMBDA_HOME=1.55
POC_LAMBDA_AWAY=1.20
