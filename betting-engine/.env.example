# ============================================================================
# Betting Decision Engine — приклад конфігурації (ТЗ §47)
#
# Скопіюйте у .env і заповніть. Порожній ключ означає «не налаштовано»:
# код НЕ підставляє мовчазний фолбек, а падає з ProviderError (ТЗ §1).
# ============================================================================

# --- База даних -------------------------------------------------------------
# Локальний запуск:
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/betting_poc
# Запуск через Docker Compose (host = імʼя сервісу):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/betting_poc

# База для інтеграційних тестів. Створюється окремо, дані затираються TRUNCATE.
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/betting_poc_test

# --- Провайдер коефіцієнтів -------------------------------------------------
# replay        — офлайн-датасет (синтетичні дані, працює без мережі)
# the_odds_api  — реальний HTTP до api.the-odds-api.com (потрібен ключ + доступ)
ODDS_PROVIDER=replay
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_REGIONS=eu

# Каталог з replay-датасетом відносно backend/.
REPLAY_DATA_DIR=data

# --- Ключі для Gate 0 harness (gate0/validate_providers.py) -----------------
# Gate 0 (ТЗ §3) перевіряє 2-3 провайдери на 20-30 матчах. Без ключів
# harness позначає клітинки NO_KEY і повертає exit code 1.
THE_ODDS_API_KEY=
API_FOOTBALL_KEY=
SPORTMONKS_API_KEY=

# --- Модель -----------------------------------------------------------------
MODEL_VERSION=0.1.0-poisson
DEFAULT_BOOKMAKER=Stake
DEFAULT_TIMEZONE=Europe/Warsaw

# Тестові lambda для PoC (ТЗ §52 п.7). Реальні рахуються у Sprint 2 (ТЗ §11).
POC_LAMBDA_HOME=1.55
POC_LAMBDA_AWAY=1.20

# --- Пороги рішень (ТЗ §25) -------------------------------------------------
# Значення за замовчуванням задані в app/models_engine/decision.py і
# потрапляють у model_runs.inputs_json кожного прогону (ТЗ §51).
# Змінювати тут — тільки разом з оновленням очікувань у тестах.

# --- Проксі (за потреби) ----------------------------------------------------
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=127.0.0.1,localhost
